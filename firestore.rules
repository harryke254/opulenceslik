rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    //
    // Collection: products
    // Document ID: {productId}
    // Fields:
    //   - id: string (required)
    //   - name: string (required)
    //   - description: string (optional)
    //   - price: number (required)
    //   - imageUrl: string (required)
    //   - category: string (required)
    //   - isPopular: boolean (optional)
    //
    // Collection: orders
    // Document ID: {orderId}
    // Fields:
    //   - id: string (required)
    //   - customerName: string (required)
    //   - customerPhone: string (required)
    //   - customerEmail: string (optional)
    //   - deliveryLocation: string (required)
    //   - items: list (required)
    //   - total: number (required)
    //   - status: string (required)
    //   - date: string (required)
    //
    // Collection: delivery_locations
    // Document ID: {locationId}
    // Fields:
    //   - id: string (required)
    //   - name: string (required)
    //   - fee: number (required)
    //
    // Collection: settings
    // Document ID: store
    // Fields:
    //   - logoUrl: string (optional)
    //   - priceFilters: list (optional)
    //
    // Collection: users
    // Document ID: {userId}
    // Fields:
    //   - email: string (required)
    //   - role: string (required)
    //
    // Collection: reviews
    // Document ID: {reviewId}
    // Fields:
    //   - id: string (required)
    //   - productId: string (required)
    //   - customerName: string (required)
    //   - rating: number (required)
    //   - comment: string (required)
    //   - date: string (required)
    //   - approved: boolean (optional)
    //
    // ===============================================================

    // ===============================================================
    // Helper Functions
    // ===============================================================
    
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.email == "harrisonreycaspian@gmail.com" ||
        request.auth.token.email == "opulenceslik7@gmail.com" ||
        request.auth.token.email == "devel0perharryke@gmail.com" ||
        request.auth.token.email == "anundaanunda7@gmail.com" ||
        request.auth.token.email == "kinarafaoke@gmail.com" ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
      );
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function hasRequiredFields(fields) {
      return request.resource.data.keys().hasAll(fields);
    }

    function hasOnlyAllowedFields(fields) {
      return request.resource.data.keys().hasOnly(fields);
    }

    // ===============================================================
    // Domain Validators
    // ===============================================================

    function isValidProduct() {
      let data = request.resource.data;
      let allowedFields = ['id', 'name', 'description', 'price', 'imageUrl', 'category', 'isPopular', 'comboItems', 'createdAt'];
      return hasRequiredFields(['id', 'name', 'price', 'imageUrl', 'category']) &&
             hasOnlyAllowedFields(allowedFields) &&
             data.id is string && data.id.size() > 0 && data.id.size() < 100 &&
             data.name is string && data.name.size() > 0 && data.name.size() < 200 &&
             (!('description' in data) || (data.description is string && data.description.size() < 5000)) &&
             data.price is number && data.price >= 0 &&
             data.imageUrl is string && data.imageUrl.size() < 1000000 &&
             data.category is string && data.category.size() > 0 && data.category.size() < 100 &&
             (!('isPopular' in data) || data.isPopular is bool) &&
             (!('comboItems' in data) || (data.comboItems is list && data.comboItems.size() < 50)) &&
             (!('createdAt' in data) || data.createdAt is number);
    }

    function isValidOrder() {
      let data = request.resource.data;
      let requiredFields = ['id', 'orderNumber', 'date', 'items', 'total', 'deliveryFee', 'finalTotal', 'customerName', 'customerPhone', 'deliveryZone', 'paymentMethod', 'status'];
      let allowedFields = ['id', 'orderNumber', 'date', 'items', 'total', 'deliveryFee', 'finalTotal', 'customerName', 'customerPhone', 'deliveryZone', 'deliveryAddress', 'paymentMethod', 'status'];
      return hasRequiredFields(requiredFields) &&
             hasOnlyAllowedFields(allowedFields) &&
             data.id is string && data.id.size() > 0 && data.id.size() < 100 &&
             data.orderNumber is string && data.orderNumber.size() > 0 && data.orderNumber.size() < 50 &&
             data.date is string && data.date.size() < 50 &&
             data.items is list && data.items.size() > 0 && data.items.size() < 100 &&
             data.total is number && data.total >= 0 &&
             data.deliveryFee is number && data.deliveryFee >= 0 &&
             data.finalTotal is number && data.finalTotal >= 0 &&
             data.customerName is string && data.customerName.size() > 0 && data.customerName.size() < 100 &&
             data.customerPhone is string && data.customerPhone.size() > 0 && data.customerPhone.size() < 50 &&
             data.deliveryZone is string && data.deliveryZone.size() > 0 && data.deliveryZone.size() < 100 &&
             (!('deliveryAddress' in data) || (data.deliveryAddress is string && data.deliveryAddress.size() < 500)) &&
             data.paymentMethod is string && data.paymentMethod in ['delivery', 'mpesa'] &&
             data.status is string && data.status in ['pending', 'processing', 'dispatched', 'delivered', 'cancelled'];
    }

    function isValidDeliveryLocation() {
      let data = request.resource.data;
      return hasRequiredFields(['id', 'name', 'fee']) &&
             data.id is string && data.id.size() > 0 && data.id.size() < 100 &&
             data.name is string && data.name.size() > 0 && data.name.size() < 100 &&
             data.fee is number && data.fee >= 0;
    }

    function isValidSettings() {
      let data = request.resource.data;
      return (!('logoUrl' in data) || (data.logoUrl is string && data.logoUrl.size() < 1000000)) &&
             (!('priceFilters' in data) || (data.priceFilters is list && data.priceFilters.size() < 20));
    }

    function isValidUser() {
      let data = request.resource.data;
      return hasRequiredFields(['email', 'role']) &&
             data.email is string && data.email.size() > 0 && data.email.size() < 100 &&
             data.role is string && data.role in ['admin', 'user'];
    }

    function isValidReview() {
      let data = request.resource.data;
      let requiredFields = ['productId', 'customerName', 'rating', 'comment', 'date'];
      let allowedFields = ['id', 'productId', 'customerName', 'rating', 'comment', 'date', 'approved'];
      return hasRequiredFields(requiredFields) &&
             hasOnlyAllowedFields(allowedFields) &&
             (!('id' in data) || (data.id is string && data.id.size() > 0 && data.id.size() < 100)) &&
             data.productId is string && data.productId.size() > 0 && data.productId.size() < 100 &&
             data.customerName is string && data.customerName.size() > 0 && data.customerName.size() < 100 &&
             data.rating is number && data.rating >= 1 && data.rating <= 5 &&
             data.comment is string && data.comment.size() > 0 && data.comment.size() < 1000 &&
             data.date is string && data.date.size() < 50 &&
             (!('approved' in data) || data.approved is bool);
    }

    // ===============================================================
    // Rules
    // ===============================================================

    match /products/{productId} {
      allow read: if true;
      allow create: if isAdmin() && isValidProduct();
      allow update: if isAdmin() && isValidProduct();
      allow delete: if isAdmin();
    }

    match /orders/{orderId} {
      allow read: if true;
      allow create: if isValidOrder();
      allow update: if isAdmin() && isValidOrder();
      allow delete: if isAdmin();
    }

    match /delivery_locations/{locationId} {
      allow read: if true;
      allow create: if isAdmin() && isValidDeliveryLocation();
      allow update: if isAdmin() && isValidDeliveryLocation();
      allow delete: if isAdmin();
    }

    match /settings/{settingId} {
      allow read: if true;
      allow create: if isAdmin() && isValidSettings();
      allow update: if isAdmin() && isValidSettings();
      allow delete: if isAdmin();
    }

    match /users/{userId} {
      allow read: if isAdmin() || isOwner(userId);
      allow create: if (isAuthenticated() && request.auth.uid == userId && isValidUser()) || isAdmin();
      allow update: if isAdmin() || (isOwner(userId) && isValidUser());
      allow delete: if isAdmin();
    }

    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isValidReview() && (!('approved' in request.resource.data) || request.resource.data.approved == false || isAdmin());
      allow update: if isAdmin() && isValidReview();
      allow delete: if isAdmin();
    }
  }
}
